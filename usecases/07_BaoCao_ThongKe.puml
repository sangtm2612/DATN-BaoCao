@startuml 07_BaoCao_ThongKe
skinparam actorStyle awesome
skinparam packageStyle rectangle

title Sơ đồ Use Case - Nhóm 7: Báo cáo và thống kê

left to right direction

actor "Staff\n(Nhân viên)" as staff
actor "Admin" as admin

' Quan hệ kế thừa - Admin có tất cả quyền của Staff
staff <|-- admin

package "Hệ thống Báo cáo và Thống kê" {
    
    usecase "Xem dashboard\ntổng quan" as UC701
    usecase "Báo cáo\ndoanh thu" as UC702
    usecase "Thống kê\nsản phẩm" as UC703
    usecase "Thống kê\nkhách hàng" as UC704
    usecase "Báo cáo\nđơn hàng" as UC705
    usecase "Xuất báo cáo" as UC706
}

' Staff - xem báo cáo
staff --> UC701
staff --> UC702
staff --> UC703
staff --> UC704
staff --> UC705

' Admin - kế thừa Staff + xuất báo cáo
admin --> UC706

@enduml
