@startuml 03_GioHang_DonHang
skinparam actorStyle awesome
skinparam packageStyle rectangle

title Sơ đồ Use Case - Nhóm 3: Quản lý giỏ hàng và đơn hàng

left to right direction

actor "Guest" as guest
actor "Customer\n(Khách đã đăng nhập)" as customer
actor "Staff\n(Nhân viên)" as staff
actor "Admin" as admin

' Quan hệ kế thừa
guest <|-- customer
customer <|-- staff
staff <|-- admin

package "Hệ thống Giỏ hàng và Đơn hàng" {
    
    ' Cart Management
    package "Quản lý Giỏ hàng" {
        usecase "Xem giỏ hàng" as UC301
        usecase "Thêm sản phẩm\nvào giỏ" as UC302
        usecase "Cập nhật\ngiỏ hàng" as UC303
        usecase "Áp dụng mã\ngiảm giá" as UC304
    }
    
    ' Order Management - Customer
    package "Quản lý Đơn hàng - Khách hàng" {
        usecase "Đặt hàng" as UC310
        usecase "Theo dõi\nđơn hàng" as UC311
        usecase "Xem lịch sử\nđơn hàng" as UC312
        usecase "Hủy đơn hàng\n(Chờ xác nhận)" as UC313
        usecase "Yêu cầu đổi/trả\nhàng" as UC314
    }
    
    ' Order Management - Staff/Admin
    package "Quản lý Đơn hàng - Xử lý" {
        usecase "Xem danh sách\nđơn hàng" as UC320
        usecase "Xác nhận\nđơn hàng" as UC321
        usecase "Cập nhật trạng thái\nđơn hàng" as UC322
        usecase "Xử lý hủy\nđơn hàng" as UC323
        usecase "Xử lý đổi/trả\nhàng" as UC324
        usecase "In hóa đơn" as UC325
    }
}

' Customer relationships
customer --> UC301
customer --> UC302
customer --> UC303
customer --> UC304
customer --> UC310
customer --> UC311
customer --> UC312
customer --> UC313
customer --> UC314

' Staff relationships - xử lý đơn hàng
staff --> UC320
staff --> UC321
staff --> UC322
staff --> UC323
staff --> UC324

' Admin relationships - kế thừa Staff + thêm in hóa đơn
admin --> UC325

' Include & Extend relationships
UC303 <.. UC302 : <<extend>>
UC310 ..> UC301 : <<include>>
UC310 ..> UC304 : <<extend>>

@enduml
