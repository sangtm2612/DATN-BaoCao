@startuml 04_ThanhToan
skinparam actorStyle awesome
skinparam packageStyle rectangle

title Sơ đồ Use Case - Nhóm 4: Quản lý thanh toán

left to right direction

actor "Guest" as guest
actor "Customer\n(Khách đã đăng nhập)" as customer
actor "Staff\n(Nhân viên)" as staff
actor "Admin" as admin

' Quan hệ kế thừa
guest <|-- customer
customer <|-- staff
staff <|-- admin

package "Hệ thống Thanh toán" {
    
    ' Payment Methods
    usecase "Chọn phương thức\nthanh toán" as UC401
    usecase "Thanh toán COD" as UC402
    usecase "Thanh toán\ntrực tuyến" as UC403
    
    ' Payment Management
    usecase "Xem lịch sử\nthanh toán" as UC404
    usecase "Xác nhận\nthanh toán" as UC405
    usecase "Xử lý hoàn tiền" as UC406
}

' Customer relationships
customer --> UC401
customer --> UC404

' Admin relationships - xử lý thanh toán
admin --> UC405
admin --> UC406

' Extend relationships
UC401 <.. UC402 : <<extend>>
UC401 <.. UC403 : <<extend>>

note right of UC403
  Tích hợp VNPay
  (Hệ thống bên ngoài)
end note

@enduml
