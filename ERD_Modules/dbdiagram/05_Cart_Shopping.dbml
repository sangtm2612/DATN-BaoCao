// Module 5: Cart & Shopping (2 tables)
// Copy toàn bộ vào https://dbdiagram.io/

// ============================================
// STUB TABLES (Referenced from other modules)
// ============================================

Table users {
  id serial [pk, increment]
  Note: 'Stub table - Defined in Module 3: Users & Authentication'
}

Table products {
  id serial [pk, increment]
  Note: 'Stub table - Defined in Module 1: Catalog & Products'
}

// ============================================
// CART & SHOPPING
// ============================================

Table carts {
  id serial [pk, increment]
  user_id int [ref: > users.id, note: 'NULL cho guest user']
  session_id varchar(100) [note: 'localStorage token cho guest']
  
  expires_at timestamp [not null, default: `now() + 30 days`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  indexes {
    user_id
    session_id
    expires_at
  }
  
  Note: 'Giỏ hàng - hỗ trợ cả guest và user đã đăng nhập. CHECK: user_id IS NOT NULL OR session_id IS NOT NULL'
}

Table cart_items {
  id serial [pk, increment]
  cart_id int [not null, ref: > carts.id]
  product_id int [not null, ref: > products.id]
  
  quantity int [not null, default: 1, note: 'CHECK (quantity > 0)']
  unit_price decimal(15,2) [not null, note: 'Snapshot giá tại thời điểm thêm']
  
  added_at timestamp [not null, default: `now()`]
  
  indexes {
    cart_id
    (cart_id, product_id) [unique]
  }
  
  Note: 'Chi tiết sản phẩm trong giỏ hàng'
}
