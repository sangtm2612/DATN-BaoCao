// Module 4: Promotions & Vouchers (6 tables)
// Copy toàn bộ vào https://dbdiagram.io/

// ============================================
// STUB TABLES (Referenced from other modules)
// ============================================

Table users {
  id serial [pk, increment]
  Note: 'Stub table - Defined in Module 3: Users & Authentication'
}

Table products {
  id serial [pk, increment]
  Note: 'Stub table - Defined in Module 1: Catalog & Products'
}

Table categories {
  id serial [pk, increment]
  Note: 'Stub table - Defined in Module 1: Catalog & Products'
}

Table brands {
  id serial [pk, increment]
  Note: 'Stub table - Defined in Module 1: Catalog & Products'
}

Table orders {
  id serial [pk, increment]
  Note: 'Stub table - Defined in Module 6: Orders & Payments'
}

// ============================================
// PROMOTIONS & VOUCHERS
// ============================================

Enum promotion_type {
  general
  build_pc
  student
  brand_deal
  give_away
  flash_sale
}

Enum discount_type {
  percent
  fixed_amount
  free_shipping
}

Table promotions {
  id serial [pk, increment]
  
  // Basic Info
  promotion_type promotion_type [not null, default: 'general']
  name varchar(200) [not null]
  description text
  
  // Discount
  discount_type discount_type [not null]
  discount_value decimal(10,2) [not null, note: '10 = 10% hoặc 10,000 VND']
  min_order_value decimal(15,2) [not null, default: 0]
  max_discount decimal(15,2) [note: 'Giới hạn giảm tối đa (cho loại %)']
  
  // Time
  start_date timestamp [not null]
  end_date timestamp [not null, note: 'Flash sale: hiện đồng hồ đếm ngược']
  is_active boolean [not null, default: true]
  
  // Build PC Policy (FR-08)
  buildpc_min_cpu_discount_pct decimal(5,2) [note: 'VD: 30.00 = giảm 30%']
  buildpc_max_cpu_discount_pct decimal(5,2) [note: 'VD: 50.00 = giảm 50%']
  buildpc_cash_bonus decimal(15,2) [note: 'Tiền mặt tặng thêm']
  buildpc_max_cash_bonus decimal(15,2) [note: 'Tối đa 30 triệu']
  
  created_by int [ref: > users.id]
  created_at timestamp [not null, default: `now()`]
  
  indexes {
    (is_active, start_date, end_date)
    promotion_type
  }
  
  Note: 'Khuyến mãi tự động áp dụng theo SP/danh mục/brand (FR-22)'
}

Table promotion_products {
  promotion_id int [not null, ref: > promotions.id]
  product_id int [not null, ref: > products.id]
  
  indexes {
    (promotion_id, product_id) [pk]
  }
  
  Note: 'Áp dụng KM cho sản phẩm cụ thể'
}

Table promotion_categories {
  promotion_id int [not null, ref: > promotions.id]
  category_id int [not null, ref: > categories.id]
  
  indexes {
    (promotion_id, category_id) [pk]
  }
  
  Note: 'Áp dụng KM cho danh mục'
}

Table promotion_brands {
  promotion_id int [not null, ref: > promotions.id]
  brand_id int [not null, ref: > brands.id]
  
  indexes {
    (promotion_id, brand_id) [pk]
  }
  
  Note: 'Áp dụng KM theo thương hiệu: ASUS, MSI, etc. (FR-22)'
}

Table vouchers {
  id serial [pk, increment]
  
  code varchar(50) [unique, not null, note: 'SUMMER2026, STUDENT50, etc.']
  name varchar(200)
  
  // Discount
  discount_type discount_type [not null]
  discount_value decimal(10,2) [not null]
  min_order_value decimal(15,2) [not null, default: 0]
  max_discount decimal(15,2)
  
  // Usage Limit
  usage_limit int [note: 'NULL = không giới hạn tổng']
  usage_per_user int [not null, default: 1]
  used_count int [not null, default: 0]
  
  // Time
  start_date timestamp [not null]
  end_date timestamp [not null]
  is_active boolean [not null, default: true]
  
  created_by int [ref: > users.id]
  created_at timestamp [not null, default: `now()`]
  
  indexes {
    code
    (is_active, start_date, end_date)
  }
  
  Note: 'Mã giảm giá nhập tay (FR-23)'
}

Table voucher_usage {
  id serial [pk, increment]
  voucher_id int [not null, ref: > vouchers.id]
  user_id int [not null, ref: > users.id]
  order_id int [ref: > orders.id, note: 'FK thêm sau khi có bảng orders']
  
  used_at timestamp [not null, default: `now()`]
  
  indexes {
    voucher_id
    user_id
  }
  
  Note: 'Lịch sử sử dụng voucher'
}
