// Module 8: Reviews (3 tables)
// Copy toàn bộ vào https://dbdiagram.io/

// ============================================
// STUB TABLES (Referenced from other modules)
// ============================================

Table users {
  id serial [pk, increment]
  Note: 'Stub table - Defined in Module 3: Users & Authentication'
}

Table products {
  id serial [pk, increment]
  Note: 'Stub table - Defined in Module 1: Catalog & Products'
}

Table order_items {
  id serial [pk, increment]
  Note: 'Stub table - Defined in Module 6: Orders & Payments'
}

// ============================================
// REVIEWS
// ============================================

Table reviews {
  id serial [pk, increment]
  product_id int [not null, ref: > products.id]
  user_id int [not null, ref: > users.id]
  order_item_id int [ref: > order_items.id, note: 'Verified purchase']
  
  rating smallint [not null, note: 'CHECK (rating BETWEEN 1 AND 5)']
  title varchar(200)
  content text
  
  is_verified boolean [not null, default: false]
  is_approved boolean [not null, default: true]
  helpful_count int [not null, default: 0]
  
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  indexes {
    product_id
    user_id
    (product_id, is_approved)
    (user_id, order_item_id) [unique]
  }
  
  Note: 'Đánh giá sản phẩm (FR-21) - Rating 1-5 sao'
}

Table review_images {
  id serial [pk, increment]
  review_id int [not null, ref: > reviews.id]
  image_url varchar(500) [not null]
  sort_order int [not null, default: 0]
  
  Note: 'Ảnh trong review (tối đa 5 ảnh - FR-21)'
}

Table review_helpful {
  user_id int [not null, ref: > users.id]
  review_id int [not null, ref: > reviews.id]
  created_at timestamp [not null, default: `now()`]
  
  indexes {
    (user_id, review_id) [pk]
  }
  
  Note: 'Đánh dấu review hữu ích - FR-21'
}
