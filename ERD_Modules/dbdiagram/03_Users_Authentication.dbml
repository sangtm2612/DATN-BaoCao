// Module 3: Users & Authentication (4 tables)
// Copy toàn bộ vào https://dbdiagram.io/

// ============================================
// USERS & AUTHENTICATION
// ============================================

Enum user_role {
  customer
  staff
  technician
  admin
}

Enum user_status {
  active
  inactive
  banned
}

Table users {
  id serial [pk, increment]
  
  // Account
  role user_role [not null, default: 'customer']
  status user_status [not null, default: 'active']
  email varchar(200) [unique, note: 'NULL nếu chỉ đăng ký qua SĐT']
  phone varchar(20) [unique]
  password_hash varchar(255) [note: 'NULL nếu chỉ dùng OAuth']
  
  // Profile
  full_name varchar(150)
  avatar_url varchar(500)
  date_of_birth date
  gender varchar(10) [note: 'male, female, other']
  
  // Verification
  email_verified boolean [not null, default: false]
  phone_verified boolean [not null, default: false]
  
  // Security
  login_attempts smallint [not null, default: 0, note: 'Reset về 0 khi login thành công']
  locked_until timestamp [note: 'NULL = không bị khóa']
  
  // Business (for invoice)
  tax_code varchar(20)
  company_name varchar(200)
  
  // Timestamps
  last_login_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  indexes {
    email
    phone
    role
    status
  }
  
  Note: 'CHECK: email IS NOT NULL OR phone IS NOT NULL'
}

Table user_addresses {
  id serial [pk, increment]
  user_id int [not null, ref: > users.id]
  
  full_name varchar(150) [not null]
  phone varchar(20) [not null]
  
  // Address Vietnam format
  province varchar(100) [not null]
  district varchar(100) [not null]
  ward varchar(100) [not null]
  address_detail varchar(300) [not null]
  
  is_default boolean [not null, default: false]
  
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  
  indexes {
    user_id
  }
  
  Note: 'Địa chỉ giao hàng (tối đa 5 địa chỉ/user theo FR-03b)'
}

Table user_tokens {
  id serial [pk, increment]
  user_id int [not null, ref: > users.id]
  
  token varchar(255) [unique, not null]
  token_type varchar(30) [not null, note: 'email_verify, phone_otp, password_reset, refresh']
  
  expires_at timestamp [not null]
  used_at timestamp
  ip_address varchar(45) [note: 'Ghi nhận IP tạo token (bảo mật)']
  
  created_at timestamp [not null, default: `now()`]
  
  indexes {
    token
    user_id
    expires_at
  }
  
  Note: 'Token xác thực: OTP, email verify, password reset, JWT refresh'
}

Table user_oauth {
  id serial [pk, increment]
  user_id int [not null, ref: > users.id]
  
  provider varchar(30) [not null, note: 'google, facebook']
  oauth_id varchar(200) [not null, note: 'ID từ provider']
  email varchar(200)
  
  created_at timestamp [not null, default: `now()`]
  
  indexes {
    user_id
    (provider, oauth_id) [unique]
  }
  
  Note: 'OAuth2 login: Google, Facebook (FR-02)'
}
